{
  "name": "dev8x",
  "version": "1.0.0",
  "private": true,
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Dev8X - Full Stack Web Application",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo run lint",
    "dev:dev8x": "npm run dev -- --filter=dev8x",
    "build:dev8x": "npm run build -- --filter=dev8x",
    "install:components": "cd packages/components && npm install",
    "install:dev8x": "cd microfrontend/dev8x && npm install",
    "install:cdn": "cd cdns/dev8x && npm install",
    "install:workspace": "npm install",
    "clean": "turbo clean && rimraf node_modules microfrontend/dev8x/.next microfrontend/dev8x/node_modules packages/components/node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "rimraf": "^5.0.1"
  },
  "dependencies": {
    "cross-env": "^10.0.0",
    "dotenv-cli": "^10.0.0",
    "force": "^0.0.3",
    "npm-run-all": "^4.1.5",
    "react-countup": "^6.5.3",
    "serve": "^14.2.4",
    "turbo": "^2.5.6",
    "wrangler": "^4.35.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.1.0",
  "workspaces": [
    "packages/components",
    "microfrontend/dev8x",
    "cdns/dev8x"
  ]
}
